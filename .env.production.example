# =============================================================================
# Production environment template for the SLSEA Solar Generation API
# =============================================================================
# Copy the variables you need into your hosting provider's "Environment
# Variables" / "Secrets" screen. NEVER commit a real .env file, APP_KEY,
# JWT_SECRET or database password to Git.
#
# Generate the two secrets locally and paste the output into the provider:
#   APP_KEY      -> php artisan key:generate --show
#   JWT_SECRET   -> php -r "echo base64_encode(random_bytes(48));"
# =============================================================================

APP_NAME="SLSEA Solar Generation API"
APP_ENV=production
APP_DEBUG=false
# Use the exact public HTTPS URL of the deployed app (no trailing slash).
APP_URL=https://your-app.up.railway.app

# --- Logging -----------------------------------------------------------------
# stderr is captured by the hosting platform's log viewer.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_STACK=single

# --- Database (MySQL) --------------------------------------------------------
# On Railway the MySQL service can fill DB_* automatically from its MYSQL* vars.
# If your provider only exposes a single connection URL, set DB_URL instead.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# DB_URL=mysql://user:password@host:3306/database
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# --- Session / cache / queue (stateless API) ---------------------------------
# "cookie" avoids a database round-trip for the stateless API and Swagger page.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- JWT authentication ------------------------------------------------------
# HS256 requires a key of at least 32 bytes (64 base64 characters).
JWT_SECRET=
JWT_ALGO=HS256
JWT_ISSUER=solar-generation-api
JWT_AUDIENCE=slsea-api
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_LEEWAY=30

# --- Transport security / rate limiting --------------------------------------
# Managed platforms terminate TLS and forward X-Forwarded-Proto; trust their
# proxy. Use an explicit CIDR list instead of "*" on self-hosted servers.
FORCE_HTTPS=true
TRUSTED_PROXIES=*
API_RATE_LIMIT=120
API_AUTH_RATE_LIMIT=10

# --- Swagger -----------------------------------------------------------------
# Keep false in production: the committed spec is regenerated at deploy time.
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_GENERATE_YAML_COPY=false

# --- Mail (not used by the API; safe no-op) ----------------------------------
MAIL_MAILER=log
